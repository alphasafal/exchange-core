---
# Focused on the failure modes that actually matter in a latency-sensitive
# engine: lifetime bugs, silent narrowing, accidental copies, and undefined
# behaviour. Stylistic checks are deliberately excluded -- clang-format owns
# formatting, and a wall of naming warnings trains people to ignore the tool.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-misleading-indentation,
  readability-redundant-*
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include|src|apps|bench)/.*'
FormatStyle: file
