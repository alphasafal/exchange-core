flowchart TB
    client([client]) -->|TCP| gw
    gw --> engine
    engine --> kill
    kill --> risk
    risk --> seq
    seq --> journal
    journal --> book
    book --> settle
    settle -->|"acks, executions"| gw
    settle --> feed
    feed -->|UDP| sub([subscribers])
    journal -.->|"segments on disk"| reader
    reader --> replay
    replay -.->|"same FNV-1a digest"| book

    subgraph transport["transport — one thread, kqueue / epoll"]
        gw["TcpGateway
frame, decode, pin account"]
        feed["UdpFeed
publish, own sequence"]
    end

    subgraph core["matching — one thread"]
        engine["MatchingEngine
routes by instrument, total order"]
        kill{{"KillSwitch
Halted"}}
        risk{{"RiskEngine
RiskLimit, PriceCollar, RateLimit"}}
        seq["assign sequence number"]
        book["OrderBook
price-time priority, O(1) cancel"]
        settle["settle risk
release STP withdrawals"]
    end

    subgraph durable["durability"]
        journal["JournalWriter
CRC-32C frames, segment rotation"]
        reader["JournalReader
torn tail vs damage"]
        replay["Replayer
ManualClock from recorded time"]
    end

    classDef gate fill:#fde68a,stroke:#b45309,color:#111827
    classDef hot fill:#bfdbfe,stroke:#1d4ed8,color:#111827
    classDef disk fill:#bbf7d0,stroke:#15803d,color:#111827
    classDef wire fill:#e9d5ff,stroke:#7e22ce,color:#111827
    classDef edge fill:#f1f5f9,stroke:#475569,color:#111827
    class kill,risk gate
    class engine,book,seq,settle hot
    class journal,reader,replay disk
    class gw,feed wire
    class client,sub edge
